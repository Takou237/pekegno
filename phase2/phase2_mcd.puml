@startuml MCD_Phase1_Referentiel_Offre
allowmixing
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
hide circle
hide methods
skinparam class {
  BackgroundColor #EAF4FB
  BorderColor #2C3E50
  HeaderBackgroundColor #2E86C1
  FontColor #1A1A2E
  AttributeFontColor #1A1A2E
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #C0392B
  FontColor #C0392B
  FontStyle bold
}
skinparam ArrowColor #5D6D7E
skinparam ArrowFontColor #2C3E50
skinparam ArrowFontSize 10

' ==================== ENTITES ====================

class AGENCE {
  __Id_Agence__
  Code
  Nom
}

class DEPARTEMENT {
  __Id_Departement__
  Nom
  Description
}

class CATEGORIE {
  __Id_Categorie__
  Nom
  Couleur
  Icone
}

class SERVICE {
  __Id_Service__
  Nom
  Description
  Prix
  Couverture
  Video_Presentation
}

class FORMATION {
  __Id_Formation__
  Type
  Duree
  Conditions
  Montant_Acompte
  Nbre_Echeances
  Paiement_En_Ligne
}

class MODULE {
  __Id_Module__
  Nom
  Ordre
  Description
  Type
  Couverture
  Video
  Pdf
}

class PROMOTION {
  __Id_Promotion__
  Prix_Promo
  Date_Debut
  Date_Fin
}

class HISTORIQUE_PRIX {
  __Id_Historique__
  Prix
  Date_Changement
}

' ==================== RELATIONS (ovales) ====================

usecase "Posséder" as R_Posseder
usecase "Proposer" as R_Proposer
usecase "Rattacher" as R_Rattacher
usecase "Classer" as R_Classer
usecase "Spécialiser" as R_Specialiser
usecase "Composer" as R_Composer
usecase "Bénéficier" as R_Beneficier
usecase "Historiser" as R_Historiser

' AGENCE - DEPARTEMENT
AGENCE -- "1,N" R_Posseder
R_Posseder -- "1,1" DEPARTEMENT

' SERVICE - AGENCE (rattachement direct)
SERVICE -- "0,1" R_Proposer
R_Proposer -- "0,N" AGENCE

' SERVICE - DEPARTEMENT (rattachement via département)
SERVICE -- "0,1" R_Rattacher
R_Rattacher -- "0,N" DEPARTEMENT

R_Proposer .[#C0392B].. R_Rattacher : <<XOR>>

' SERVICE - CATEGORIE
SERVICE -- "1,1" R_Classer
R_Classer -- "0,N" CATEGORIE

' SERVICE - FORMATION
SERVICE -- "0,1" R_Specialiser
R_Specialiser -- "1,1" FORMATION

' FORMATION - MODULE
FORMATION -- "1,1" R_Composer
R_Composer -- "0,N" MODULE

' SERVICE - PROMOTION
SERVICE -- "0,N" R_Beneficier
R_Beneficier -- "1,1" PROMOTION

' SERVICE - HISTORIQUE_PRIX
SERVICE -- "0,N" R_Historiser
R_Historiser -- "1,1" HISTORIQUE_PRIX

@enduml
