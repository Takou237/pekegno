@startuml MCD_Phase2_Coeur_Metier
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam entity {
  BorderColor #E67E22
  BorderThickness 2
  FontColor #2C3E50
  FontSize 10
  BackgroundColor #FDEBD0
}
skinparam cardinality {
  FontColor #E74C3C
  FontSize 10
}
skinparam arrow {
  Color #7F8C8D
  Thickness 2
}

left to right direction

' ==================================================================
' ENTITÉS DE RÉFÉRENCE (Phase 1)
' ==================================================================
entity "AGENCE" as agence {
  + id
  --
  code
  nom
}

entity "DEPARTEMENT" as departement {
  + id
  --
  nom
}

entity "CATEGORIE" as categorie {
  + id
  --
  nom
  couleur
  icone
}

entity "UTILISATEUR" as user {
  + id
  --
  nom
  email
  role
}
note right of user
  Un formateur = User avec role "formateur"
  Un apprenant = User avec role "client"
end note

' ==================================================================
' ENTITÉS CŒUR MÉTIER (Phase 2)
' ==================================================================

entity "SERVICE" as service {
  + id
  --
  nom
  description
  prix : DECIMAL(12,2)
  couverture
  video_presentation
}

entity "PROMOTION" as promo {
  + id
  --
  prix_promo : DECIMAL(12,2)
  date_debut : DATETIME
  date_fin : DATETIME
}

entity "HISTORIQUE_PRIX" as histoprix {
  + id
  --
  prix : DECIMAL(12,2)
  date : TIMESTAMP
}

entity "FORMATION" as training {
  + id
  --
  type : PRESENTIEL / DISTANCIEL
  duree
  conditions
  montant_acompte : DECIMAL
  nbre_echeances
  paiement_en_ligne : BOOLEAN
}

entity "MODULE" as module {
  + id
  --
  nom
  ordre
  description
  type : VIDEO / PDF
  couverture
  video
  pdf
}

entity "INSCRIPTION" as enrollment {
  + id
  --
  statut : INSCRIT / EN_COURS / TERMINE / ANNULE
  montant_total : DECIMAL
  montant_paye : DECIMAL
  solde : DECIMAL
  nom
  prenom
  nationalite
  telephone
  ville
  pays
  quartier
  occupation
  email
}

entity "ECHEANCE" as installment {
  + id
  --
  montant : DECIMAL
  date_echeance : DATE
  date_paiement : DATETIME
  statut : IMPAYE / PAYE / EN_RETARD
  penalite : DECIMAL
}

entity "PROGRESSION" as progress {
  + id
  --
  statut : PAS_COMMENCE / EN_COURS / TERMINE
  date_debut
  date_fin
}

' ==================================================================
' RELATIONS
' ==================================================================

' --- Phase 1 → Phase 2 ---
categorie   "(1,N)" -- "(1,1)" service         : "classifie"
agence      "(1,N)" -- "(0,1)" service         : "propose"
departement "(1,N)" -- "(0,1)" service         : "rattaché à"

' --- Services ---
service     "(1,1)" -- "(0,N)" histoprix       : "historique"
service     "(1,1)" -- "(0,N)" promo           : "promotion"
service     "(0,1)" -- "(1,1)" training        : "formation"

' --- Formations ---
training    "(1,1)" -- "(0,N)" module          : "composé de"
training    "(1,1)" -- "(0,N)" enrollment      : "inscrit"

' --- Modules ---
module      "(0,N)" -- "(0,1)" user            : "dispensé par"

' --- Inscriptions ---
user        "(0,N)" -- "(1,1)" enrollment      : "s'inscrit à"
enrollment  "(1,1)" -- "(0,N)" progress        : "progresse"
enrollment  "(1,1)" -- "(0,N)" installment     : "échelonné"
module      "(1,1)" -- "(0,N)" progress        : "suivi dans"

@enduml
