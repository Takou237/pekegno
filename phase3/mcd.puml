@startuml MCD_Phase3_Clients_Commerciaux_Factures
allowmixing
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
hide circle
hide methods
skinparam class {
  BackgroundColor #EAF4FB
  BorderColor #2C3E50
  HeaderBackgroundColor #2E86C1
  FontColor #1A1A2E
  AttributeFontColor #1A1A2E
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #C0392B
  FontColor #C0392B
  FontStyle bold
}
skinparam ArrowColor #5D6D7E
skinparam ArrowFontColor #2C3E50
skinparam ArrowFontSize 10

' ==================== ENTITES ====================

class USER {
  __Id_User__
  Identifiants
  Email
  Telephone
  Role
  Actif
}

class CLIENT {
  __Id_Client__
  Numero_Client
  Ville
  Pays
  Adresse
}

class COMMERCIAL {
  __Id_Commercial__
  Nom
  Prenom
  Email
  Telephone
  Type_Commission
  Valeur_Commission
  Actif
}

class AGENCE {
  __Id_Agence__
  Code
  Nom
}

class DEPARTEMENT {
  __Id_Departement__
  Nom
  Description
}

class CATEGORIE {
  __Id_Categorie__
  Nom
  Couleur
  Icone
}

class SERVICE {
  __Id_Service__
  Nom
  Description
  Prix
  Couverture
}

class PROMOTION {
  __Id_Promotion__
  Type (Montant / %)
  Prix_Promo
  Pourcentage
  Date_Debut
  Date_Fin
}

class HISTORIQUE_PRIX {
  __Id_Historique__
  Prix
  Date_Changement
}

class FACTURE {
  __Id_Facture__
  Numero
  Date
  Type_Paiement
  Total
  Avance
  Montant_Paye
  Statut
  Commentaire
}

class LIGNE_FACTURE {
  __Id_Ligne__
  Libelle (snapshot)
  Prix_Unitaire
  Quantite
  Total_Ligne
}

class PAIEMENT {
  __Id_Paiement__
  Montant
  Methode
  Est_Acompte
  Date
  Encaisser_Par
}

class POINT_COMMERCIAL {
  __Id_Point__
  Points (+/-)
  Raison (vente/pénalité/ajustement)
}

class REGLAGE {
  __Id_Reglage__
  Cle
  Valeur
}

class LOG_ACTION {
  __Id_Log__
  Action
  Entite
  Anciennes_Valeurs
  Nouvelles_Valeurs
  Ip
}

class LOG_CONNEXION {
  __Id_Log__
  Action
  Ip
  Motif_Echec
}

' ==================== RELATIONS (ovales) ====================

usecase "Spécialiser" as R_Specialiser
usecase "Lier" as R_Lier
usecase "Employer" as R_Employer
usecase "Posséder" as R_Posseder
usecase "Proposer" as R_Proposer
usecase "Rattacher" as R_Rattacher
usecase "Classer" as R_Classer
usecase "Bénéficier" as R_Beneficier
usecase "Historiser" as R_Historiser
usecase "Émettre" as R_Emettre
usecase "Concerner" as R_Concerner
usecase "Vendre" as R_Vendre
usecase "Composer" as R_Composer
usecase "Référencer" as R_Referencer
usecase "Régler" as R_Regler
usecase "Collecter" as R_Collecter
usecase "Déclencher" as R_Declencher
usecase "Paramétrer" as R_Parametrer
usecase "Tracer" as R_Tracer

' USER - CLIENT (spécialisation)
USER -- "1,1" R_Specialiser
R_Specialiser -- "0,1" CLIENT

' USER - COMMERCIAL (profil lié optionnel)
USER -- "0,1" R_Lier
R_Lier -- "0,1" COMMERCIAL

' COMMERCIAL - AGENCE
AGENCE -- "0,N" R_Employer
R_Employer -- "0,1" COMMERCIAL

' AGENCE - DEPARTEMENT
AGENCE -- "1,N" R_Posseder
R_Posseder -- "1,1" DEPARTEMENT

' SERVICE - AGENCE / DEPARTEMENT (XOR)
SERVICE -- "0,1" R_Proposer
R_Proposer -- "0,N" AGENCE

SERVICE -- "0,1" R_Rattacher
R_Rattacher -- "0,N" DEPARTEMENT

R_Proposer .[#C0392B].. R_Rattacher : <<XOR>>

' SERVICE - CATEGORIE
SERVICE -- "1,1" R_Classer
R_Classer -- "0,N" CATEGORIE

' SERVICE - PROMOTION
SERVICE -- "0,N" R_Beneficier
R_Beneficier -- "1,1" PROMOTION

' SERVICE - HISTORIQUE_PRIX
SERVICE -- "0,N" R_Historiser
R_Historiser -- "1,1" HISTORIQUE_PRIX

' FACTURE - AGENCE (émise par)
FACTURE -- "0,N" R_Emettre
R_Emettre -- "0,1" AGENCE

' FACTURE - CLIENT (concerne)
FACTURE -- "0,N" R_Concerner
R_Concerner -- "0,1" CLIENT

' FACTURE - COMMERCIAL (vendue par, optionnel)
FACTURE -- "0,N" R_Vendre
R_Vendre -- "0,1" COMMERCIAL

' FACTURE - LIGNES
FACTURE -- "1,1" R_Composer
R_Composer -- "0,N" LIGNE_FACTURE

' LIGNE_FACTURE - SERVICE (référence snapshot optionnelle)
LIGNE_FACTURE -- "0,N" R_Referencer
R_Referencer -- "0,1" SERVICE

' FACTURE - PAIEMENTS (encaissements / acomptes)
FACTURE -- "1,1" R_Regler
R_Regler -- "0,N" PAIEMENT

' COMMERCIAL - POINTS
COMMERCIAL -- "0,N" R_Collecter
R_Collecter -- "1,1" POINT_COMMERCIAL

' FACTURE - POINTS (déclenche les points à la clôture)
FACTURE -- "0,N" R_Declencher
R_Declencher -- "1,1" POINT_COMMERCIAL

' REGLAGE - COMMERCIAL (paramètres globaux)
REGLAGE -- "0,N" R_Parametrer
R_Parametrer -- "1,1" COMMERCIAL

' LOGS - USER
LOG_ACTION -- "0,N" R_Tracer
R_Tracer -- "1,1" USER

LOG_CONNEXION -- "0,N" R_Tracer
R_Tracer -- "1,1" USER

@enduml
