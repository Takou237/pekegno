<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Un fichier de build absent (ancien build supprimé) doit répondre 404, pas
  # index.html : sinon le navigateur reçoit du HTML à la place d'un module JS.
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html n'est jamais mis en cache : après un déploiement, le navigateur
  # récupère tout de suite la liste des nouveaux fichiers.
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # JS / CSS / polices ne sont produits que dans assets/, avec un nom haché par
  # build : cache long sans risque (les images à la racine, elles, n'en ont pas).
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
