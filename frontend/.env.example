# URL de base de l'API Laravel (Dev1)
# En dev, laisser vide fonctionne aussi grâce au proxy Vite (/api -> localhost:8000)
# Laisser vide pour passer par le proxy Vite (/api -> localhost:8000)
# Évite les erreurs CORS en dev local
# VITE_API_URL=http://localhost:8000/api

# Durée d'inactivité (minutes) avant déconnexion auto côté front
# Doit rester cohérente avec SESSION_LIFETIME côté backend (.env Dev1)
VITE_INACTIVITY_TIMEOUT_MINUTES=120
